// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  games    Game[] @relation("GameUsers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game[]
  hand      Hand?    @relation(fields: [handId], references: [id])
  handId    String?
}

model Game {
  id             String @id @default(uuid())
  name           String
  status         String @default("waiting")
  scores         Json
  targetScore    Int
  cardsPerPlayer Int
  currentRound   Int

  players User[] @relation("GameUsers")
  hands   Hand[] @relation("GameHands")

  winnerId Int?
  winner   User? @relation(fields: [winnerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hand {
  id                 String @id @default(uuid())
  currentPlayerId    Int
  dealerId           Int
  winnerId           Int?
  playersWhoDrewCard Json
  playersWhoSaidUno  Json
  newColor           String
  playingDirection   String @default("clockwise")
  status             String @default("in_progress")

  gameId      String
  game        Game   @relation("GameHands", fields: [gameId], references: [id])
  players     User[]
  discardPile Json
  drawPile    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
